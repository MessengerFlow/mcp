{
  "name": "@messengerflow/mcp-server",
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MessengerFlow/mcp.git"
  },
  "homepage": "https://messengerflow.com/docs/integrations/mcp-server",
  "bugs": {
    "url": "https://github.com/MessengerFlow/mcp/issues"
  },
  "description": "MCP server for MessengerFlow \u2014 manage campaigns, accounts, leads, inbox, and analytics via AI assistants",
  "bin": {
    "messengerflow-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "dev:remote": "tsx src/remote.ts",
    "start": "node dist/index.js",
    "start:remote": "node dist/remote.js",
    "test": "tsx --test src/*.test.ts src/tools/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^4.21.0",
    "jose": "^6.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist/index.js"
  ]
}
